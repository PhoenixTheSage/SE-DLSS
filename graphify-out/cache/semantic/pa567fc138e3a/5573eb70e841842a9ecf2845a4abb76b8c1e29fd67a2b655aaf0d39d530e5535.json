: null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_configdialogexample_vertical_scrollbar", "label": "Vertical Scrollbar", "file_type": "concept", "source_file": "Docs/ConfigDialogExample.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_configdialogexample_label_control_row", "label": "Label-Left Control-Right Row", "file_type": "rationale", "source_file": "Docs/ConfigDialogExample.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each setting is a two-column row: a left-aligned name and a right-aligned control of uniform width so mixed widget types (checkbox, slider, text, combo, color, keybind) share one visual grid."}, {"id": "docs_configdialogexample_widget_catalog", "label": "Plugin Config Widget Catalog", "file_type": "rationale", "source_file": "Docs/ConfigDialogExample.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The dialog is a demo catalog of supported plugin config widgets, not a live product page: dummy labels (Toggle, Integer, Number, Text, Dropdown, Color, Color with alpha, Keybind, Button) and placeholder values (Default Text, First Alpha, none) enumerate every control type the config UI can host."}, {"id": "docs_configdialogexample_numeric_type_split", "label": "Integer Versus Number Slider Split", "file_type": "rationale", "source_file": "Docs/ConfigDialogExample.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Integer and Number share the same slider chrome but differ in readout: Integer shows a whole value (2) while Number shows a decimal (0.1), so discrete and continuous numeric settings are distinct widget types."}, {"id": "docs_configdialogexample_rgba_hex_extension", "label": "RGBA Hex Extends RGB Color", "file_type": "rationale", "source_file": "Docs/ConfigDialogExample.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Color without alpha uses a 6-digit RGB hex (00FFFF) beside a saturated swatch; Color with alpha uses an 8-digit RGBA hex (00000055) beside a semi-transparent swatch, so alpha is an extra nibble pair on the same color-row pattern."}], "edges": [{"source": "docs_configdialogexample", "target": "docs_configdialogexample_config_demo_dialog", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Docs/ConfigDialogExample.png", "source_location": null, "weight": 1.0}, {"source": "docs_configdialogexample_config_demo_dialog", "target": "docs_configdialogexample_close_button", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Docs/ConfigDialogExample.png", "source_location": null, "weight": 1.0}, {"source": "docs_configdialogexample_config_demo_dialog", "target": "docs_configdialogexample_some_settings", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Docs/ConfigDialogExample.png", "source_location": null, "weight": 1.0}, {"source": "docs_configdialogexample_config_demo_dialog", "target": "docs_configdialogexample_more_settings", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Docs/ConfigDialogExample.png", "source_location": null, "weight": 1.0}, {"source": "docs_configdialogexample_config_demo_dialog", "target": "docs_configdialogexample_vertical_scrollbar", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Docs/ConfigDialogExample.png", "source_location": null, "weight": 1.0}, {"source": "docs_configdialogexample_section_header", "target": "docs_configdialogexample_some_settings", "relation": "conceptually_related_to", "confidence": "